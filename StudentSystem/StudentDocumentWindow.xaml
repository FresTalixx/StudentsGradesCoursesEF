<Window x:Class="StudentSystem.StudentDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Document" Height="420" Width="600" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
            <TextBlock x:Name="TxtStudentInfo" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Create or edit the document data and optional student photo." Foreground="Gray"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Width="130" VerticalAlignment="Center" Text="Document number:"/>
            <TextBox x:Name="TbDocumentNumber" Width="250"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Width="130" VerticalAlignment="Center" Text="Issued at:"/>
            <DatePicker x:Name="DpIssuedAt" Width="150"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Width="130" VerticalAlignment="Center" Text="Expiry date:"/>
            <DatePicker x:Name="DpExpiryDate" Width="150"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Width="130" VerticalAlignment="Center" Text="Photo:"/>
            <Button x:Name="BtnBrowsePhoto" Content="Browse..." Width="90" Click="BtnBrowsePhoto_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.RowSpan="5" Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="6" Margin="10,0,0,0">
            <Image x:Name="ImgPreview" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSave" Content="Save" Width="90" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
