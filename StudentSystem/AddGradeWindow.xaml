<Window x:Class="StudentSystem.AddGradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Grade" Height="300" Width="420">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label>Student</Label>
        <ComboBox x:Name="CbStudents" DisplayMemberPath="FirstName" Grid.Row="0" Margin="0,20,0,0"/>

        <Label Grid.Row="1" Margin="0,8,0,0">Course</Label>
        <ComboBox x:Name="CbCourses" DisplayMemberPath="Name" Grid.Row="1" Margin="0,28,0,0"/>

        <Label Grid.Row="2" Margin="0,8,0,0">Numeric Grade</Label>
        <TextBox x:Name="TbNumeric" Grid.Row="2" Margin="0,28,0,0"/>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="80" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Content="Cancel" Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>